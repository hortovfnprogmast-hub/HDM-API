<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Cuestionario Instalación | HDM</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
/* ====== CSS COMPARTIDO CUESTIONARIOS HDM ====== */
:root {
    --primary-blue: #043185; --light-blue: #eef2ff; --bg-color: #f8fafc;
    --text-main: #1e293b; --text-muted: #64748b; --border-color: #e2e8f0;
    --danger: #dc2626; --success: #10b981; --warning: #f59e0b;
}
body { margin: 0; font-family: 'Inter', sans-serif; background-color: var(--bg-color); display: flex; flex-direction: column; min-height: 100vh; }
.header { display: flex; justify-content: space-between; align-items: center; padding: 10px 20px; background: white; border-bottom: 3px solid var(--primary-blue); position: sticky; top: 0; z-index: 50; }
.header-left { display: flex; align-items: center; gap: 15px; }
.header-title { margin: 0; font-size: 15px; font-weight: 700; color: var(--primary-blue); }
.header-right { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--text-muted); font-weight: 600; }
.badge-formato { background: var(--primary-blue); color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 700; }
.content { flex: 1; padding: 20px; }
.container { max-width: 900px; margin: 0 auto; padding-bottom: 60px; }
.page-header { margin-bottom: 25px; border-bottom: 2px solid var(--border-color); padding-bottom: 15px; text-align: center; }
.page-header h1 { font-size: 22px; color: var(--primary-blue); margin: 0 0 5px 0; font-weight: 800; text-transform: uppercase; }
.page-header p { color: var(--text-muted); margin: 0; font-size: 14px; }
.form-card { background: #FFFFFF; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 4px 10px rgba(0,0,0,0.03); margin-bottom: 24px; padding: 24px; }
.form-card.highlight { border-left: 4px solid var(--primary-blue); }
.section-title-form { display: flex; align-items: center; gap: 12px; font-size: 18px; font-weight: 700; color: var(--primary-blue); margin: 0 0 20px 0; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); }
.section-title-form i { color: var(--primary-blue); }
.form-group { margin-bottom: 16px; }
.form-label { display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
.form-input, .form-select, textarea.form-input { width: 100%; padding: 12px 14px; background-color: var(--bg-color); border: 1px solid var(--border-color); border-radius: 8px; font-size: 14px; color: var(--text-main); box-sizing: border-box; font-family: inherit; outline: none; transition: all 0.2s ease; }
.form-input:focus, .form-select:focus, textarea.form-input:focus { background-color: #FFFFFF; border-color: var(--primary-blue); box-shadow: 0 0 0 3px rgba(4, 49, 133, 0.1); }
.form-row { display: grid; grid-template-columns: 1fr; gap: 12px; }
@media (min-width: 768px) { .form-row { grid-template-columns: repeat(3, 1fr); } }
.ubicacion-row { display: grid; grid-template-columns: 1fr; gap: 16px; align-items: start; }
@media (min-width: 768px) { .ubicacion-row { grid-template-columns: 2fr 1fr; } }
.ubicacion-foto { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.photo-controls { display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
.btn-photo, .btn-photo-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 6px; cursor: pointer; font-weight: 700; font-size: 13px; transition: all 0.2s; border: none; }
.btn-photo { background: var(--primary-blue); color: white; }
.btn-photo:hover { background: #032a5c; }
.btn-photo-secondary { background: white; color: #374151; border: 1px solid #d1d5db; }
.photo-slot { aspect-ratio: 1; border: 2px dashed #d1d5db; border-radius: 8px; background: #f9fafb; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; cursor: pointer; }
.photo-slot img { width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; }
.photo-slot.small { width: 150px; height: 150px; aspect-ratio: auto; }
.remove-photo { position: absolute; top: 5px; right: 5px; background: rgba(0,0,0,0.6); color: white; border-radius: 50%; width: 24px; height: 24px; text-align: center; line-height: 22px; cursor: pointer; font-size: 16px; font-weight: bold; z-index: 10; }
.photo-label { font-size: 11px; font-weight: 700; color: var(--primary-blue); text-transform: uppercase; margin-bottom: 6px; text-align: center; }
.photo-grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 8px; }
.photo-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 8px; }
@media (max-width: 600px) { .photo-grid-3 { grid-template-columns: repeat(2, 1fr); } .photo-grid-2 { grid-template-columns: 1fr; } }
.photo-rubric { display: flex; flex-direction: column; gap: 4px; }
.data-table-container { background: #FFFFFF; border-radius: 12px; border: 1px solid var(--border-color); overflow-x: auto; margin-top: 8px; }
table.datos { width: 100%; border-collapse: collapse; min-width: 600px; }
table.datos thead { background: var(--primary-blue); color: white; }
table.datos th { padding: 10px 8px; font-size: 12px; font-weight: 700; text-align: center; text-transform: uppercase; border: 1px solid #032a5c; }
table.datos td { padding: 6px 8px; font-size: 13px; border: 1px solid var(--border-color); }
table.datos td.label { font-weight: 700; color: var(--primary-blue); background: var(--light-blue); text-align: left; }
table.datos td.input-cell { padding: 0; }
table.datos td.input-cell input { width: 100%; border: none; padding: 10px 8px; font-size: 13px; background: transparent; outline: none; font-family: inherit; color: var(--text-main); }
table.datos td.input-cell input:focus { background: var(--light-blue); }
table.datos td.colspan-cell { text-align: center; font-weight: 600; color: var(--text-muted); font-size: 11px; }
.radio-group { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
.radio-option { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s; }
.radio-option input { accent-color: var(--primary-blue); width: 18px; height: 18px; }
.radio-option.aceptado.checked { background: rgba(16, 185, 129, 0.1); border-color: var(--success); color: var(--success); }
.radio-option.no-aceptado.checked { background: rgba(220, 38, 38, 0.1); border-color: var(--danger); color: var(--danger); }
.signature-container { border: 2px dashed #d1d5db; border-radius: 8px; background: #fafafa; position: relative; margin-bottom: 10px; width: 100%; overflow: hidden; }
.signature-pad { width: 100%; height: 200px; cursor: crosshair; touch-action: none; display: block; }
.btn-guardar { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 20px; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; background: var(--success); color: white; border: none; width: 100%; margin-bottom: 12px; }
.btn-enviar { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 20px; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; background: var(--primary-blue); color: white; border: none; width: 100%; }
.modal-enlarger { display: none; position: fixed !important; z-index: 999999 !important; left: 0 !important; top: 0 !important; width: 100vw !important; height: 100vh !important; background-color: rgba(0,0,0,0.95) !important; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; }
.modal-enlarger.show { display: flex !important; }
.modal-content-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; cursor: zoom-out; }
#camera-overlay { display: none; position: fixed !important; z-index: 999999 !important; left: 0 !important; top: 0 !important; width: 100vw !important; height: 100vh !important; background-color: rgba(0,0,0,0.95) !important; flex-direction: column; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; }
#camera-overlay.show { display: flex !important; }
#camera-stream { width: 100%; max-width: 600px; aspect-ratio: 4/3; background: black; border-radius: 12px; overflow: hidden; position: relative; }
#camera-video { width: 100%; height: 100%; object-fit: cover; }
#custom-alert { display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 10000; justify-content: center; align-items: center; padding: 20px; box-sizing: border-box; }
.modal-card-alert { background: white; border-radius: 12px; padding: 24px; width: 100%; max-width: 400px; text-align: center; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); }
#alert-icon-container { margin-bottom: 16px; display: flex; justify-content: center; }
#alert-title { margin: 0 0 8px 0; font-size: 18px; color: var(--text-main); font-weight: 700; }
#alert-msg { margin: 0 0 24px 0; font-size: 13px; color: var(--text-muted); line-height: 1.5; text-align: left; }
#alert-btn { width: 100%; padding: 12px; border-radius: 8px; border: none; color: white; background: var(--primary-blue); font-weight: 700; font-size: 14px; cursor: pointer; }
    </style>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>
<body>

    <header class="header">
        <div class="header-left">
            <img src="https://i.ibb.co/217VSVMh/logo-hdm.png" alt="Logo HDM" style="height: 40px; object-fit: contain;">
            <h1 class="header-title">Proyecto · Orden de Servicio Instalación</h1>
        </div>
        <div class="header-right"><span class="badge-formato">INSTALACIÓN</span></div>
    </header>

    <main class="content">
        <div class="container">
            <div class="page-header">
                <h1>Cuestionario de Instalación</h1>
                <p>Completa la información para generar el reporte de instalación (4 páginas)</p>
            </div>

            <form id="cuestionarioForm">

                <!-- UBICACIÓN -->
                <div class="form-card highlight">
                    <h3 class="section-title-form"><i data-lucide="map-pin"></i> Ubicación de la Instalación</h3>
                    <div class="ubicacion-row">
                        <div>
                            <div class="form-group"><label class="form-label">Dirección</label><input type="text" class="form-input" id="direccion" placeholder="Captura la dirección completa..."></div>
                            <div class="form-group"><label class="form-label">Colonia</label><input type="text" class="form-input" id="colonia" placeholder="Captura la colonia..."></div>
                        </div>
                        <div class="ubicacion-foto">
                            <label class="photo-label">Foto de la ubicación</label>
                            <div class="photo-controls"><button type="button" class="btn-photo" onclick="triggerCamera('ubicacion')"><i data-lucide="camera"></i></button><button type="button" class="btn-photo-secondary" onclick="triggerFile('ubicacion')"><i data-lucide="upload"></i></button></div>
                            <div class="photo-slot small" id="slot-ubicacion-0"><i data-lucide="image" style="color:#ccc;width:30px;height:30px;"></i></div>
                        </div>
                    </div>
                </div>

                <!-- EMPLEADO PROVEEDOR -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="user-cog"></i> Empleado del Proveedor</h3>
                    <div class="ubicacion-row">
                        <div>
                            <div class="form-group"><label class="form-label">Nombre</label><input type="text" class="form-input" id="prov_nombre" placeholder="Nombre completo..."></div>
                            <div class="form-group"><label class="form-label">Cargo</label><input type="text" class="form-input" id="prov_cargo" placeholder="Cargo..."></div>
                            <div class="form-group"><label class="form-label">Celular</label><input type="tel" class="form-input" id="prov_celular" placeholder="10 dígitos"></div>
                        </div>
                        <div class="ubicacion-foto">
                            <label class="photo-label">Foto del empleado</label>
                            <div class="photo-controls"><button type="button" class="btn-photo" onclick="triggerCamera('proveedor')"><i data-lucide="camera"></i></button><button type="button" class="btn-photo-secondary" onclick="triggerFile('proveedor')"><i data-lucide="upload"></i></button></div>
                            <div class="photo-slot small" id="slot-proveedor-0"><i data-lucide="image" style="color:#ccc;width:30px;height:30px;"></i></div>
                        </div>
                    </div>
                </div>

                <!-- ANÁLISIS FÍSICO-QUÍMICO -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="droplets"></i> Análisis Físico-Químico de Agua</h3>
                    <div class="data-table-container">
                        <table class="datos">
                            <thead><tr><th style="width:20%;">Muestra</th><th>Cloro<br><small>0-0.5</small></th><th>pH<br><small>6.5-8.5</small></th><th>Dureza<br><small>0-100</small></th><th>TDS<br><small>0-500</small></th><th>Alcalinidad<br><small>0</small></th><th>Cloruros<br><small>0-2</small></th><th>Otros</th></tr></thead>
                            <tbody>
                                <tr><td class="label">AGUA CRUDA</td><td class="input-cell"><input type="text" id="aq_cruda_cloro"></td><td class="input-cell"><input type="text" id="aq_cruda_ph"></td><td class="input-cell"><input type="text" id="aq_cruda_dureza"></td><td class="input-cell"><input type="text" id="aq_cruda_tds"></td><td class="input-cell"><input type="text" id="aq_cruda_alcalinidad"></td><td class="input-cell"><input type="text" id="aq_cruda_cloruros"></td><td class="input-cell"><input type="text" id="aq_cruda_otros"></td></tr>
                                <tr><td class="label">AGUA FILTRADA</td><td class="input-cell"><input type="text" id="aq_filtrada_cloro"></td><td class="input-cell"><input type="text" id="aq_filtrada_ph"></td><td class="input-cell"><input type="text" id="aq_filtrada_dureza"></td><td class="input-cell"><input type="text" id="aq_filtrada_tds"></td><td class="input-cell"><input type="text" id="aq_filtrada_alcalinidad"></td><td class="input-cell"><input type="text" id="aq_filtrada_cloruros"></td><td class="input-cell"><input type="text" id="aq_filtrada_otros"></td></tr>
                                <tr><td class="label">AGUA OSMÓTICA</td><td class="input-cell"><input type="text" id="aq_osmotica_cloro"></td><td class="input-cell"><input type="text" id="aq_osmotica_ph"></td><td class="input-cell"><input type="text" id="aq_osmotica_dureza"></td><td class="input-cell"><input type="text" id="aq_osmotica_tds"></td><td class="input-cell"><input type="text" id="aq_osmotica_alcalinidad"></td><td class="input-cell"><input type="text" id="aq_osmotica_cloruros"></td><td class="input-cell"><input type="text" id="aq_osmotica_otros"></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- EQUIPO FILTRACIÓN INSTALADO -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="filter"></i> Equipo de Filtración (Instalado)</h3>
                    <div class="data-table-container">
                        <table class="datos">
                            <thead><tr><th style="width:20%;">Equipo</th><th>Modelo</th><th>Tipo y Tamaño</th><th>No. Serie</th><th>Notas</th></tr></thead>
                            <tbody id="tablaFiltracion"></tbody>
                        </table>
                    </div>
                </div>

                <!-- EQUIPO BOMBEO INSTALADO -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="zap"></i> Equipo de Bombeo (Instalado)</h3>
                    <div class="data-table-container">
                        <table class="datos">
                            <thead><tr><th style="width:20%;">Equipo</th><th>Modelo</th><th>Tipo y Tamaño</th><th>No. Serie</th><th>Notas</th></tr></thead>
                            <tbody id="tablaBombeo"></tbody>
                        </table>
                    </div>
                </div>

                <!-- EQUIPO CALENTADOR INSTALADO -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="thermometer"></i> Equipo Calentador (Instalado)</h3>
                    <div class="data-table-container">
                        <table class="datos">
                            <thead><tr><th style="width:20%;">Equipo</th><th>Modelo</th><th>Tipo y Tamaño</th><th>No. Serie</th><th>Notas</th></tr></thead>
                            <tbody id="tablaCalentador"></tbody>
                        </table>
                    </div>
                </div>

                <!-- FOTOS: todas las secciones se generan dinámicamente -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="camera"></i> Reporte Fotográfico</h3>
                    <div id="photoSections"></div>
                </div>

                <!-- OBSERVACIONES -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="clipboard"></i> Observaciones</h3>
                    <div class="form-group"><textarea class="form-input" id="observaciones" rows="4" placeholder="Observaciones generales..."></textarea></div>
                </div>

                <!-- EMPLEADO RECIBE -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="user-check"></i> Empleado que Recibe el Trabajo</h3>
                    <div class="ubicacion-row">
                        <div>
                            <div class="form-group"><label class="form-label">Nombre</label><input type="text" class="form-input" id="recibe_nombre" placeholder="Nombre completo..."></div>
                            <div class="form-group"><label class="form-label">Cargo</label><input type="text" class="form-input" id="recibe_cargo" placeholder="Cargo..."></div>
                            <div class="form-group"><label class="form-label">Celular</label><input type="tel" class="form-input" id="recibe_celular" placeholder="10 dígitos"></div>
                        </div>
                        <div class="ubicacion-foto">
                            <label class="photo-label">Foto del empleado</label>
                            <div class="photo-controls"><button type="button" class="btn-photo" onclick="triggerCamera('recibe')"><i data-lucide="camera"></i></button><button type="button" class="btn-photo-secondary" onclick="triggerFile('recibe')"><i data-lucide="upload"></i></button></div>
                            <div class="photo-slot small" id="slot-recibe-0"><i data-lucide="image" style="color:#ccc;width:30px;height:30px;"></i></div>
                        </div>
                    </div>
                </div>

                <!-- ESTATUS + COMENTARIO + FIRMA -->
                <div class="form-card">
                    <h3 class="section-title-form"><i data-lucide="clipboard-check"></i> Cierre del Servicio</h3>
                    <div class="form-group"><label class="form-label">Estatus del Servicio</label><div class="radio-group"><label class="radio-option aceptado" id="radio-aceptado"><input type="radio" name="estatus" value="aceptado" checked> ACEPTADO</label><label class="radio-option no-aceptado" id="radio-no-aceptado"><input type="radio" name="estatus" value="no_aceptado"> NO ACEPTADO</label></div></div>
                    <div class="form-group"><label class="form-label">Comentario de Salida</label><textarea class="form-input" id="comentario_salida" rows="3" placeholder="Comentarios finales..."></textarea></div>
                    <div class="form-group"><label class="form-label">Firma de quien recibe</label><div class="signature-container"><canvas class="signature-pad" id="firma_recibe"></canvas></div><input type="hidden" id="firma_recibe_data"><button type="button" class="btn-photo-secondary" onclick="limpiarFirma('firma_recibe')"><i data-lucide="eraser"></i> Limpiar firma</button></div>
                </div>

                <button type="button" class="btn-guardar" onclick="guardarBorrador()"><i data-lucide="save"></i> GUARDAR BORRADOR</button>
                <button type="button" class="btn-enviar" onclick="verPDF()"><i data-lucide="file-text"></i> GENERAR PDF LLENO</button>
            </form>
        </div>
    </main>

    <script>
// ====== INFRAESTRUCTURA COMPARTIDA CUESTIONARIOS HDM ======
// Cada cuestionario define: FOTOS_CONFIG, STORAGE_KEY, recopilarDatos(), cargarBorrador()
// Opcional: renderPhotoRubrics(), initPage(), RUBROS_FOTOS

let fotos = {};
let activeTarget = 'ubicacion', currentFacingMode = 'environment', currentStream;
let canvasFirma, ctxFirma;

// ====== INYECTAR MODALES EN EL DOM ======
function injectModals() {
    if (document.getElementById('custom-alert')) return;
    const div = document.createElement('div');
    div.innerHTML = `
    <div id="custom-alert">
        <div class="modal-card-alert">
            <div id="alert-icon-container"></div>
            <h3 id="alert-title"></h3>
            <p id="alert-msg"></p>
            <button id="alert-btn" onclick="closeCustomAlert()">ACEPTAR</button>
        </div>
    </div>
    <div id="camera-overlay">
        <div id="camera-stream"><video id="camera-video" autoplay playsinline></video></div>
        <div style="margin-top:15px;display:flex;gap:10px;">
            <button class="btn-photo" onclick="captureFoto()"><i data-lucide="camera"></i> CAPTURAR</button>
            <button class="btn-photo-secondary" onclick="switchCamera()"><i data-lucide="refresh-cw"></i> VOLTEAR</button>
            <button class="btn-photo-secondary" onclick="closeCamera()"><i data-lucide="x"></i> CANCELAR</button>
        </div>
    </div>
    <div class="modal-enlarger" id="photoModal" onclick="closePhotoModal()"><img class="modal-content-img" id="imgFull" src=""></div>
    <input type="file" id="fileInputGlobal" accept="image/*" style="display:none" onchange="processFile(this)">
    <canvas id="tempCanvas" style="display:none"></canvas>`;
    document.body.appendChild(div);
}

// ====== INIT ======
document.addEventListener('DOMContentLoaded', () => {
    injectModals();
    // Construir objeto fotos desde FOTOS_CONFIG
    if (window.FOTOS_CONFIG) {
        Object.keys(FOTOS_CONFIG).forEach(k => { fotos[k] = new Array(FOTOS_CONFIG[k]).fill(null); });
    }
    // Añadir rubros dinámicos desde RUBROS_FOTOS
    if (window.RUBROS_FOTOS) {
        RUBROS_FOTOS.forEach((_, i) => { fotos['rubro_' + i] = [null]; });
    }
    // Renderizar todos los slots
    Object.keys(fotos).forEach(k => renderSlots(k));
    // Rubros dinámicos
    if (typeof renderPhotoRubrics === 'function') renderPhotoRubrics();
    // Firma
    inicializarFirma();
    // Estatus radios
    document.querySelectorAll('input[name="estatus"]').forEach(r => {
        r.addEventListener('change', actualizarEstiloEstatus);
    });
    actualizarEstiloEstatus();
    // Validar celulares
    ['prov_celular','recibe_celular'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', e => { e.target.value = e.target.value.replace(/[^0-9]/g,'').slice(0,10); });
    });
    // Restaurar borrador
    if (window.STORAGE_KEY) {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) { try { cargarBorrador(JSON.parse(saved)); } catch(e) { console.warn('No se pudo restaurar', e); } }
    }
    // Init específico de página
    if (window.initPage) initPage();
    if (window.lucide) lucide.createIcons();
});

// ====== ALERTAS ======
function showCustomAlert(t, m, s=true) {
    const a = document.getElementById('custom-alert');
    document.getElementById('alert-title').innerText = t;
    document.getElementById('alert-msg').innerText = m;
    const ic = document.getElementById('alert-icon-container'), b = document.getElementById('alert-btn');
    if(s){ ic.innerHTML='<i data-lucide="check-circle" style="width:48px;height:48px;color:var(--success)"></i>'; b.style.background='var(--success)'; }
    else{ ic.innerHTML='<i data-lucide="alert-triangle" style="width:48px;height:48px;color:var(--danger)"></i>'; b.style.background='var(--danger)'; }
    a.style.display = 'flex'; if(window.lucide) lucide.createIcons();
}
function closeCustomAlert() { document.getElementById('custom-alert').style.display = 'none'; }

// ====== CÁMARA Y ARCHIVOS ======
function triggerFile(t) {
    activeTarget = t;
    if (!fotos[t]) { showCustomAlert('Error','Rubro no existe: '+t, false); return; }
    const libres = fotos[t].filter(f => f === null).length;
    if (libres > 0) document.getElementById('fileInputGlobal').click();
    else showCustomAlert('Atención', 'Límite de fotos alcanzado para este rubro.', false);
}

function processFile(input) {
    if (!input.files || input.files.length === 0) return;
    const r = new FileReader();
    r.onload = function(e) {
        const img = new Image();
        img.onload = function() {
            const c = document.createElement('canvas');
            let w = img.width, h = img.height; const m = 800;
            if (w > m || h > m) { if (w > h) { h = (h/w)*m; w = m; } else { w = (w/h)*m; h = m; } }
            c.width = w; c.height = h;
            c.getContext('2d').drawImage(img, 0, 0, w, h);
            const data = c.toDataURL('image/jpeg', 0.7);
            const idx = fotos[activeTarget].findIndex(f => f === null);
            if (idx > -1) { fotos[activeTarget][idx] = data; renderSlots(activeTarget); }
            input.value = '';
        };
        img.src = e.target.result;
    };
    r.readAsDataURL(input.files[0]);
}

async function triggerCamera(t) {
    activeTarget = t;
    if (!fotos[t]) { showCustomAlert('Error','Rubro no existe: '+t, false); return; }
    const libres = fotos[t].filter(f => f === null).length;
    if (libres === 0) { showCustomAlert('Atención', 'Límite de fotos alcanzado.', false); return; }
    currentFacingMode = (t === 'proveedor' || t === 'recibe') ? 'user' : 'environment';
    await startCamera();
}

async function startCamera() {
    if (currentStream) currentStream.getTracks().forEach(t => t.stop());
    try {
        currentStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: currentFacingMode } });
        document.getElementById('camera-video').srcObject = currentStream;
        document.getElementById('camera-overlay').classList.add('show');
    } catch(e) { showCustomAlert('Error', 'Cámara no disponible.', false); }
}
function switchCamera() { currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment'; startCamera(); }
function closeCamera() { if (currentStream) currentStream.getTracks().forEach(t => t.stop()); document.getElementById('camera-overlay').classList.remove('show'); }

function captureFoto() {
    const c = document.getElementById('tempCanvas'), v = document.getElementById('camera-video');
    c.width = v.videoWidth; c.height = v.videoHeight;
    const x = c.getContext('2d');
    if (currentFacingMode === 'user') { x.translate(c.width, 0); x.scale(-1, 1); }
    x.drawImage(v, 0, 0, c.width, c.height); x.setTransform(1, 0, 0, 1, 0, 0);
    const idx = fotos[activeTarget].findIndex(f => f === null);
    if (idx > -1) { fotos[activeTarget][idx] = c.toDataURL('image/jpeg', 0.8); renderSlots(activeTarget); }
    closeCamera();
}

function removeFoto(t, i) { fotos[t][i] = null; renderSlots(t); }
function enlargePhoto(s) { document.getElementById('imgFull').src = s; document.getElementById('photoModal').classList.add('show'); }
function closePhotoModal() { document.getElementById('photoModal').classList.remove('show'); }

function renderSlots(t) {
    if (!fotos[t]) return;
    for (let i = 0; i < fotos[t].length; i++) {
        const s = document.getElementById(`slot-${t}-${i}`); if (!s) continue;
        if (fotos[t][i]) {
            s.innerHTML = `<img src="${fotos[t][i]}" onclick="enlargePhoto(this.src)" style="width:100%;height:100%;object-fit:cover;cursor:zoom-in;border-radius:8px"><span class="remove-photo" onclick="removeFoto('${t}',${i})">&times;</span>`;
            s.style.border = '1px solid var(--border-color)';
        } else {
            s.innerHTML = `<i data-lucide="image" style="color:#ccc;width:30px;height:30px"></i>`;
            s.style.border = '2px dashed #d1d5db';
        }
    }
    if (window.lucide) lucide.createIcons();
}

// ====== FIRMA ======
function inicializarFirma() {
    canvasFirma = document.getElementById('firma_recibe'); if (!canvasFirma) return;
    ctxFirma = canvasFirma.getContext('2d');
    canvasFirma.width = 600; canvasFirma.height = 200;
    ctxFirma.lineWidth = 3; ctxFirma.lineCap = 'round'; ctxFirma.strokeStyle = '#043185';
    let drawing = false;
    function getPos(e) {
        const r = canvasFirma.getBoundingClientRect();
        const cx = e.touches ? e.touches[0].clientX : e.clientX;
        const cy = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: (cx - r.left) * (canvasFirma.width / r.width), y: (cy - r.top) * (canvasFirma.height / r.height) };
    }
    canvasFirma.addEventListener('mousedown', e => { drawing = true; const p = getPos(e); ctxFirma.beginPath(); ctxFirma.moveTo(p.x, p.y); });
    canvasFirma.addEventListener('mousemove', e => { if (drawing) { const p = getPos(e); ctxFirma.lineTo(p.x, p.y); ctxFirma.stroke(); } });
    window.addEventListener('mouseup', () => { if (drawing) { drawing = false; document.getElementById('firma_recibe_data').value = canvasFirma.toDataURL(); } });
    canvasFirma.addEventListener('touchstart', e => { e.preventDefault(); drawing = true; const p = getPos(e); ctxFirma.beginPath(); ctxFirma.moveTo(p.x, p.y); }, { passive: false });
    canvasFirma.addEventListener('touchmove', e => { e.preventDefault(); if (drawing) { const p = getPos(e); ctxFirma.lineTo(p.x, p.y); ctxFirma.stroke(); } }, { passive: false });
    window.addEventListener('touchend', () => { if (drawing) { drawing = false; document.getElementById('firma_recibe_data').value = canvasFirma.toDataURL(); } });
}
function limpiarFirma(id) { if (ctxFirma) ctxFirma.clearRect(0, 0, canvasFirma.width, canvasFirma.height); const el = document.getElementById(id + '_data'); if (el) el.value = ''; }

// ====== ESTATUS ======
function actualizarEstiloEstatus() {
    const el = document.querySelector('input[name="estatus"]:checked');
    if (!el) return;
    const v = el.value;
    const a = document.getElementById('radio-aceptado'), na = document.getElementById('radio-no-aceptado');
    if (a) a.classList.toggle('checked', v === 'aceptado');
    if (na) na.classList.toggle('checked', v === 'no_aceptado');
}

// ====== GUARDAR BORRADOR (genérico) ======
function guardarBorrador() {
    if (typeof recopilarDatos !== 'function') return;
    const datos = recopilarDatos();
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(datos));
        showCustomAlert('Éxito', 'Borrador guardado correctamente en este dispositivo.', true);
    } catch(e) {
        showCustomAlert('Error', 'No se pudo guardar el borrador: ' + e.message, false);
    }
}

// ====== VER PDF (genérico) ======
function verPDF() {
    if (typeof recopilarDatos !== 'function') return;
    const datos = recopilarDatos();
    if (!datos.direccion) { showCustomAlert('Atención', 'Captura la dirección del servicio.', false); return; }
    if (!datos.proveedor || !datos.proveedor.nombre) { showCustomAlert('Atención', 'Captura el nombre del empleado del proveedor.', false); return; }
    if (!datos.recibe || !datos.recibe.nombre) { showCustomAlert('Atención', 'Captura el nombre de quien recibe el trabajo.', false); return; }
    try {
        sessionStorage.setItem('DatosCuestionarioHDM', JSON.stringify(datos));
        window.open(PDF_URL, '_blank');
    } catch(e) {
        showCustomAlert('Error', 'No se pudo abrir el PDF: ' + e.message, false);
    }
}

// ====== HELPER ======
function val(id) { const el = document.getElementById(id); if (!el) return '—'; const v = el.value.trim(); return v === '' ? '—' : v; }
function setVal(id, v) { if (v && v !== '—') { const el = document.getElementById(id); if (el) el.value = v; } }
